import { createServerFn } from "@tanstack/react-start";
import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
import { z } from "zod";
import { callJson } from "./ai.server";
import { PRESENTATION_RULES, presentationContext } from "./presentation";
import type { AuraPackage } from "./aura";
const s = { type: "string" }, a = { type: "array", items: s };
const obj = (properties: Record<string, unknown>) => ({ type: "object", additionalProperties: false, required: Object.keys(properties), properties });
const schema = obj({ title: s, invitation: s, why_it_works: s, variations: { type: "array", items: obj({ level: { type: "string", enum: ["safe", "intermediate", "bold"] }, summary: s, clothing: s, makeup: s, hair: s, beard: s, accessories: s, tattoo_visibility: s }) }, cost: { type: "string", enum: ["low", "medium", "high"] }, cost_note: s, maintenance: { type: "string", enum: ["low", "medium", "high"] }, reversibility: { type: "string", enum: ["easy", "moderate", "permanent"] }, adaptation_time: s, risks: a, professional_validation: { type: "boolean" }, professional_validation_note: s, steps: a, event_checklist: a });
export const generateBeardPlan = createServerFn({ method: "POST" }).middleware([requireSupabaseAuth]).inputValidator(d => z.object({ presentation: z.enum(["masculine", "feminine"]).optional() }).parse(d)).handler(async ({ data, context: { supabase, userId } }) => {
  const [{ data: bp }, { data: vp }, { data: consent }, { data: dna }] = await Promise.all([supabase.from("beard_profiles").select("data").eq("user_id", userId).maybeSingle(), supabase.from("visual_profiles").select("data").eq("user_id", userId).maybeSingle(), supabase.from("consents").select("personalization,dna_paused,module_permissions").eq("user_id", userId).maybeSingle(), supabase.from("visual_dna").select("summary").eq("user_id", userId).maybeSingle()]);
  if (!consent || !bp) return { id: null, error: "Salve o perfil de barba primeiro." };
  const perms = consent.module_permissions as Record<string, boolean>;
  const dnaAllowed = consent.personalization && !consent.dna_paused && perms["beard"] === true;
  const r = await callJson<AuraPackage>(`Você é a assistente de Barba da Aura ID. Português brasileiro, sem julgamento. ${PRESENTATION_RULES} Gere exatamente 3 alternativas safe, intermediate, bold. Em beard detalhe desenho, comprimento, contornos, bigode e relação com cabelo. Respeite ausência de barba, densidade natural, sensibilidade, tempo e orçamento. Nada de corrigir falhas, prometer crescimento, diagnosticar ou recomendar medicamentos. Campos clothing,makeup,accessories,tattoo_visibility: Não se aplica. steps: rotina básica com frequência sugerida e guia de barbearia (o que pedir e perguntas ao profissional). professional_validation=true quando há sensibilidade informada. Custos descritivos sem inventar preços de serviços. Reversão easy ou moderate, nunca garantir crescimento.`, JSON.stringify({ perfil: bp.data, estrutura: presentationContext(vp?.data, data.presentation), dna: dnaAllowed ? dna?.summary : null }), schema, "beard_plan");
  if (!r.ok) return { id: null, error: r.error };
  const { data: row, error } = await supabase.from("packages").insert({ user_id: userId, batch_id: crypto.randomUUID(), kind: "beard_plan", module: "beard", entry_mode: "beard", context: { presentation: presentationContext(vp?.data, data.presentation).apresentacao }, content: r.data as never }).select("id").single();
  if (error || !row) return { id: null, error: "Não foi possível salvar o plano." };
  await supabase.from("audit_events").insert({ user_id: userId, event: "beard_plan_generated", meta: { dna_used: dnaAllowed } });
  return { id: row.id, error: null };
});